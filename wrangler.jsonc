// RC-4 (Cloudflare D1 port). Used by `wrangler dev` (local mode) and the Vitest Workers
// integration. Not approved for deploy: no account_id, routes, workers.dev or preview URLs,
// and the D1 database_id below is a PLACEHOLDER that matches no real database. The real
// production D1 is bound only under env.production (selected with `--env production`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local/dev only. A bare `wrangler deploy` must not target the production Worker.
  // env.production is the only env named "resiliencecoaching".
  "name": "resiliencecoaching-local",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "app/public",
    "binding": "ASSETS",
    // The Worker runs first so /api/* reaches the handler and the app's security headers
    // are applied to static responses too (as netlify.toml's forced rewrite did).
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "EMAIL_MODE": "preview",
    "PAYMENT_MODE": "demo",
    // Explicit on purpose: overrides the code default (pt_direct, same as app/pt-stripe.cjs).
    "STRIPE_INTEGRATION": "connect",
    // RC-14: off by default. Set to "true" only to re-enable the multi-trainer marketplace.
    "MULTI_PT_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resiliencecoaching-local",
      // PLACEHOLDER for local development only (wrangler dev / vitest). Not a real database.
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Serialised writer for multi-step read-then-write flows (see src/writer.mjs).
  "durable_objects": {
    "bindings": [{ "name": "WRITER", "class_name": "Writer" }]
  },
  // SQLite-backed class so it is also valid on the Workers Free plan. The writer keeps no
  // storage of its own; all data lives in D1.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Writer"] }],
  // Cron Trigger (src/mail.mjs): email delivery (booking + password-reset mail) and
  // housekeeping (expire holds, prune rate limits). QA D1-D3 (f978692): this default env has
  // NO cron trigger and no CRON_ENABLED. env.preview and env.production each have
  // both; production is only selected with `--env production`. Two layers: no schedule here,
  // and cronTick is a no-op unless CRON_ENABLED is "true" (CR 5941600057). Test:
  // tests/remote-guards.test.mjs reads this file through wrangler's own config resolver.
  // Local: wrangler dev --test-scheduled, then GET /__scheduled. Do not deploy the default env.
  "observability": { "enabled": false },
  // Preview (approved 17 Nov 2026, item 6). Uploaded through the Cloudflare API, not
  // `wrangler deploy`. workers.dev is enabled only behind Cloudflare Access (docs §13).
  // PAYMENT_MODE "stripe_test" is the app's test mode (PAYMENT_MODE=test is not a valid value).
  // No Stripe key or webhook secret is set, so every non-diagnostic API route answers 503
  // before any Stripe call or write (worker/index.mjs paymentReadiness, CR 5941600057 M6).
  // No Resend key: mail stays in preview. Static assets: the API upload ships app/public as
  // text modules behind docs/rc-4/preview/entry.mjs (connector cannot run the assets upload).
  // Secrets (set through the API, never committed): PT_INVITE_SECRET.
  "env": {
    "preview": {
      "name": "resiliencecoaching-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "EMAIL_MODE": "preview",
        "PAYMENT_MODE": "stripe_test",
        "STRIPE_INTEGRATION": "connect",
        "MULTI_PT_ENABLED": "false",
        "APP_URL": "https://resiliencecoaching-preview.littlk.workers.dev",
        "CRON_ENABLED": "true",
        // Runtime preview marker: Workers cannot read a D1 binding's id, so the
        // out-of-band reset gate checks this var and fails closed when it is absent.
        "D1_DATABASE_ID": "81379d2e-c718-48b7-870d-1d189feea966"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "resiliencecoaching-preview",
          "database_id": "81379d2e-c718-48b7-870d-1d189feea966",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "WRITER", "class_name": "Writer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Writer"] }],
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true }
    },
    // Production Worker (L1). Deploy only with `wrangler deploy --env production` after
    // Kieran's yes. Secrets are names only in docs/launch-production.md; never commit values.
    // www is a custom domain; the Worker 301s it to the apex (worker/index.mjs).
    "production": {
      "name": "resiliencecoaching",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "EMAIL_MODE": "send",
        "RESET_EMAIL_MODE": "send",
        "PAYMENT_MODE": "stripe_live",
        "STRIPE_INTEGRATION": "connect",
        "MULTI_PT_ENABLED": "false",
        "APP_URL": "https://resiliencecoaching.app",
        "CRON_ENABLED": "true",
        "MAIL_FROM": "bookings@mail.resiliencecoaching.app",
        // Runtime id for the reset gate. The preview out-of-band path stays fail-closed:
        // this is the production database, EMAIL_MODE is send, and APP_URL is the apex.
        "D1_DATABASE_ID": "fd8a613f-4dd4-462b-83e0-d7673031a6fc"
      },
      "routes": [
        { "pattern": "resiliencecoaching.app", "custom_domain": true },
        { "pattern": "www.resiliencecoaching.app", "custom_domain": true }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "resiliencecoaching",
          "database_id": "fd8a613f-4dd4-462b-83e0-d7673031a6fc",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "WRITER", "class_name": "Writer" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Writer"] }],
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true }
    }
  }
}
